<?xml version="1.0" encoding="UTF-8"?>
<!--
  TrustGuard SpotBugs exclusion filter.

  Rule 19.5: "Exclusion file: spotbugs-exclude.xml. Each exclusion requires
  a comment with reviewer and date."

  IMPORTANT — never write the end-of-comment marker (the two-dash plus
  angle-bracket sequence) inside a comment block. It closes the comment
  at that point, and any text after it becomes invalid top-level XML
  content. The parser reports this as "Content is not allowed in prolog."
  Describe the marker in prose; do not type it literally.
-->
<FindBugsFilter>

    <!--
      Reviewer: Jesse | Date: 2026-09-28 | Next review: 2026-12-28
      Justification: EI_EXPOSE_REP2 (may expose internal representation by
      storing an externally mutable object) fires on every field that holds
      a Spring container-managed singleton bean. EntityManager, JdbcTemplate,
      ObjectMapper, StringRedisTemplate, and service references are
      intentionally shared across the application and are thread-safe by
      design (or proxied to be). These are not "externally mutable" in the
      sense the rule was written for — they are container-owned dependencies
      injected once at startup. The warning is a known SpotBugs false
      positive on Spring constructor injection. Reviewed quarterly.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Or>
            <Class name="com.trustguard.infrastructure.aspect.TenantRlsAspect"/>
            <Class name="com.trustguard.infrastructure.repository.BaseRepositoryImpl"/>
            <Class name="com.trustguard.sdk.filter.ApiKeyAuthFilter"/>
            <Class name="com.trustguard.sdk.filter.SecurityEventLogger"/>
            <Class name="com.trustguard.sdk.service.KeyLookupService"/>
            <Class name="com.trustguard.sdk.service.KeyRevocationService"/>
            <Class name="com.trustguard.api.admin.auth.AdminJwtFilter"/>
            <Class name="com.trustguard.api.admin.auth.AdminSecurityEventWriter"/>
        </Or>
    </Match>

    <!--
      Reviewer: Agent 4 | Date: 2026-10-09 | Next review: 2027-01-09
      Justification: CT_CONSTRUCTOR_THROW on AdminJwtService is the
      intentional startup gate (Rule 5.9, RULING 2): the constructor refuses
      to start the application when ADMIN_JWT_SECRET is missing, invalid
      base64, or shorter than 32 bytes. The object is a Spring singleton
      created once at startup; a failed construction aborts context startup,
      so a partially constructed instance is never reachable. Marking the
      class final would not change this — the finalizer-attack concern does
      not apply to a bean whose construction failure prevents the context
      from ever becoming available to callers.
    -->
    <Match>
        <Class name="com.trustguard.api.admin.auth.AdminJwtService"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

</FindBugsFilter>