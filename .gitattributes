# Normalize line endings to LF on commit for all text files
* text=auto eol=lf

# Java source files — always LF
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.properties text eol=lf

# Binary files — do not touch
*.jar binary
*.class binary
*.png binary
*.jpg binary