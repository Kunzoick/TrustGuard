# TrustGuard Environment Variables
# Copy to .env for local development
# NEVER commit .env to version control

HMAC_SIGNING_KEY_PRIMARY=
HMAC_SIGNING_KEY_SECONDARY=
DB_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
ADMIN_JWT_SECRET=
TRUSTGUARD_ALLOW_INSECURE_PRODUCTION=
HMAC_SIGNING_KEY=
AUTH_RESOLVER_DB_PASSWORD=
ADMIN_JWT_SECRET= (base64, at least 32 bytes decoded; generate with openssl rand -base64 32).