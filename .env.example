# TrustGuard Environment Variables
# Copy to .env for local development
# NEVER commit .env to version control

HMAC_SIGNING_KEY_PRIMARY=
HMAC_SIGNING_KEY_SECONDARY=
DB_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
# Base64, at least 32 bytes decoded. Generate with: openssl rand -base64 32
ADMIN_JWT_SECRET=
TRUSTGUARD_ALLOW_INSECURE_PRODUCTION=
HMAC_SIGNING_KEY=
AUTH_RESOLVER_DB_PASSWORD=
# First platform admin (B-007b). Read only while admin_users is empty; required in production then.
# Password: at least 12 characters, at most 72 UTF-8 bytes, different from the username.
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=
# Event identity key (Ruling 50). Base64, at least 32 bytes decoded. Generate with: openssl rand -base64 32
# The application refuses to start without it.
EVENT_HMAC_KEY=
# Redis timeouts (Rule 9.8). Defaults: 50ms for commands, 200ms for connecting. Uncomment to override.
# REDIS_COMMAND_TIMEOUT=50ms
# REDIS_CONNECT_TIMEOUT=200ms